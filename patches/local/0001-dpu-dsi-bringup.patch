diff --git a/drivers/gpu/drm/drm_atomic_helper.c b/drivers/gpu/drm/drm_atomic_helper.c
index 285aac355..96a4109c6 100644
--- a/drivers/gpu/drm/drm_atomic_helper.c
+++ b/drivers/gpu/drm/drm_atomic_helper.c
@@ -2605,11 +2605,18 @@ int drm_atomic_helper_setup_commit(struct drm_atomic_commit *state,
 		 */
 		if (nonblock && old_plane_state->commit &&
 		    !try_wait_for_completion(&old_plane_state->commit->flip_done)) {
+			/*
+			 * TBEXP-C6: wlroots compositors pass NONBLOCK on every
+			 * commit and treat -EBUSY as fatal, wedging the display
+			 * for good.  Wait for the previous commit instead --
+			 * exactly the blocking semantics Weston uses, and the
+			 * only thing that works on this DPU.
+			 */
 			drm_dbg_atomic(plane->dev,
-				       "[PLANE:%d:%s] busy with a previous commit\n",
+				       "[PLANE:%d:%s] waiting for a previous commit\n",
 				       plane->base.id, plane->name);
 
-			return -EBUSY;
+			drm_crtc_commit_wait(old_plane_state->commit);
 		}
 
 		/* Always track planes explicitly for async pageflip support. */
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
index 1206b8d81..2c226b501 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
@@ -3247,9 +3247,17 @@ static int dpu_encoder_setup_display(struct dpu_encoder_virt *dpu_enc,
 
 	DPU_DEBUG("dsi_info->num_of_h_tiles %d\n", disp_info->num_of_h_tiles);
 
+	/*
+	 * TBEXP-C5: never let the DPU enter RC IDLE on DSI.
+	 *
+	 * RC IDLE disables the INTF interrupts, the vblank stops, and the
+	 * flip_done of the pending commit never completes.  Any following
+	 * nonblocking atomic commit then fails with -EBUSY in
+	 * drm_atomic_helper_setup_commit(), which is fatal for wlroots
+	 * compositors (they don't do blocking commits).
+	 */
 	if (disp_info->intf_type != INTF_WB)
-		dpu_enc->idle_pc_supported =
-				dpu_kms->catalog->caps->has_idle_pc;
+		dpu_enc->idle_pc_supported = false;
 
 	mutex_lock(&dpu_enc->enc_lock);
 	for (i = 0; i < disp_info->num_of_h_tiles && !ret; i++) {
